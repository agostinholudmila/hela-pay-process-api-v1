#%RAML 1.0 DataType
type: object
properties:
  xferId:
    type: !include cr-reference-id.raml
    description: |
      Control Record Reference do Service Domain Payment
      Instruction. Identificador único da transferência.
      (IFX: xferId — correspondência direta)
  fromAccRef:
    type: string
    description: |
      IBAN/número da conta de origem.
      (IFX: fromAccRef — correspondência direta)
  curAmt:
    type: number
    format: double
    description: |
      Valor e moeda da transferência.
      (IFX: curAmt — correspondência direta)
  telefoneDestino:
    type: !include telefone-destino.raml
    description: |
      Número de telefone de destino.
      (IFX: sem correspondência direta — o mapeamento oficial
      assume conta_destino_id -> toAcctRef, mas aqui o destino
      é identificado por telefone/wallet, não por conta)
  XferStatus:
    type: !include xfer-status.raml
example: !include ../examples/payment-instruction.raml   