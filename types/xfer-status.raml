#%RAML 1.0 DataType
type: string
enum: [PENDING, AUTHORIZED, EXECUTED, FAILED, REVERSED]
description: |
  PENDING     — pedido recebido, ainda em processamento
  AUTHORIZED  — débito autorizado pelo sistema de origem
  EXECUTED    — débito na origem e crédito no destino confirmados
  FAILED      — falha antes da conclusão (ex: limite excedido ou fraude)
  REVERSED    — transferência revertida após conclusão